<Window x:Class="GestiCoop3.view.AjouterEtudiantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajouter un étudiant"
        Width="460" Height="463"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        Background="White"
        FontFamily="Segoe UI"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="LabelChamp" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#718096"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="ChampTexte" TargetType="TextBox">
            <Setter Property="Height" Value="39"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#243044"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <!-- cadre du formulaire d'ajout -->
    <Border Background="White" BorderBrush="#CBD5E1"
            BorderThickness="1" CornerRadius="7">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="48"/>
            </Grid.RowDefinitions>

            <!-- bandeau bleu du formulaire -->
            <Grid Grid.Row="0" Background="#24517B">
                <TextBlock Text="Ajouter un étudiant" Foreground="White"
                           FontSize="15" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="18,0"/>
                <Button Content="×" Width="42" Height="48"
                        HorizontalAlignment="Right" Background="Transparent"
                        Foreground="#DCE6F1" BorderThickness="0" FontSize="23"
                        Cursor="Hand" Click="Fermer_Click"/>
            </Grid>

            <!-- champs à remplir -->
            <StackPanel Grid.Row="1" Margin="19,18,19,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="13"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="NOM *" Style="{StaticResource LabelChamp}"/>
                        <TextBox x:Name="NomTextBox" Style="{StaticResource ChampTexte}"
                                 TextChanged="Champ_TextChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="PRÉNOM *" Style="{StaticResource LabelChamp}"/>
                        <TextBox x:Name="PrenomTextBox" Style="{StaticResource ChampTexte}"
                                 TextChanged="Champ_TextChanged"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="COURRIEL *" Style="{StaticResource LabelChamp}"
                           Margin="0,14,0,6"/>
                <TextBox x:Name="CourrielTextBox" Style="{StaticResource ChampTexte}"
                         TextChanged="Champ_TextChanged"/>

                <TextBlock x:Name="ErreurTextBlock"
                           Text="⚠ Adresse courriel invalide — ex. : prenom.nom@etud.lacite.ca"
                           Foreground="#F04438" FontSize="11" Margin="0,6,0,0"
                           TextWrapping="Wrap" Visibility="Collapsed"/>

                <TextBlock Text="PROGRAMME *" Style="{StaticResource LabelChamp}"
                           Margin="0,14,0,6"/>
                <ComboBox x:Name="ProgrammeComboBox" Height="37" Padding="8"
                          SelectedIndex="0" SelectionChanged="Champ_SelectionChanged">
                    <ComboBoxItem Content="Informatique"/>
                    <ComboBoxItem Content="Génie logiciel"/>
                    <ComboBoxItem Content="Cybersécurité"/>
                </ComboBox>

                <TextBlock Text="NUMÉRO D'ÉTUDIANT" Style="{StaticResource LabelChamp}"
                           Margin="0,14,0,6"/>
                <TextBox x:Name="NumeroTextBox" Style="{StaticResource ChampTexte}"
                         ToolTip="Optionnel" TextChanged="Champ_TextChanged"/>
                <TextBlock Text="Format : 7 chiffres (ex. : 2024001)"
                           Foreground="#718096" FontSize="11" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- commandes du formulaire -->
            <Border Grid.Row="2" BorderBrush="#CBD5E1"
                    BorderThickness="0,1,0,0" Background="White">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,19,0">
                    <Button Content="Annuler" Width="79" Height="29"
                            Margin="0,0,9,0" Background="White"
                            Foreground="#718096" BorderBrush="#CBD5E1"
                            Click="Annuler_Click" Cursor="Hand"/>
                    <Button x:Name="EnregistrerButton" Content="Enregistrer"
                            Width="97" Height="29" Background="#D84935"
                            Foreground="White" FontWeight="SemiBold"
                            BorderThickness="0" IsEnabled="False"
                            Click="Enregistrer_Click" Cursor="Hand"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>


</Window>
