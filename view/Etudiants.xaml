<Window x:Class="GestiCoop3.view.Etudiants"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GestiCoop — Gestion des stages coopératifs"
        Width="1100" Height="720"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6FA"
        FontFamily="Segoe UI">
    <!-- structure générale de la page étudiants -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- bandeau supérieur de l'application -->
        <Border Grid.Row="0" Background="#24517B">
            <Grid>
                <TextBlock Text="GestiCoop — Gestion des stages coopératifs"
                           Foreground="White" FontSize="14" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="15,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,15,0">
                    <Ellipse Width="13" Height="13" Fill="#6485A3" Margin="0,0,7,0"/>
                    <Ellipse Width="13" Height="13" Fill="#6485A3" Margin="0,0,7,0"/>
                    <Ellipse Width="13" Height="13" Fill="#C56B78"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- menu latéral et zone de travail -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#214A75">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="18,22,10,0">
                        <TextBlock Text="GestiCoop" Foreground="White"
                                   FontSize="17" FontWeight="Bold"/>
                        <TextBlock Text="Stages coopératifs" Foreground="#B9CDE0"
                                   FontSize="11" Margin="0,3,0,25"/>
                        <TextBlock Text="PRINCIPAL" Foreground="#9DB6CE"
                                   FontSize="10" FontWeight="Bold" Margin="0,0,0,12"/>
                        <TextBlock Text="▦  Tableau de bord" Foreground="#D8E4EF"
                                   Padding="4,9"/>
                        <TextBlock Text="▣  Offres de stage" Foreground="#D8E4EF"
                                   Padding="4,9"/>
                        <Border Background="#376795" CornerRadius="3" Margin="-8,0,0,0">
                            <TextBlock Text="♟  Étudiants" Foreground="White"
                                       FontWeight="Bold" Padding="12,10"/>
                        </Border>
                        <TextBlock Text="▣  Candidatures" Foreground="#D8E4EF"
                                   Padding="4,9"/>
                        <TextBlock Text="▣  Entreprises" Foreground="#D8E4EF"
                                   Padding="4,9"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="18,0,10,18">
                        <TextBlock Text="Amine Alioui" Foreground="White"
                                   FontWeight="Bold" FontSize="11"/>
                        <TextBlock Text="Coordonnateur" Foreground="#B9CDE0"
                                   FontSize="10"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- contenu principal de la liste -->
            <Grid Grid.Column="1" Margin="20,18,20,15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="55"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock Text="Liste des étudiants" FontSize="19"
                               FontWeight="SemiBold" Foreground="#26364A"
                               VerticalAlignment="Center"/>
                    <Button Content="+ Ajouter un étudiant" Width="165" Height="34"
                            HorizontalAlignment="Right" Background="#D84935"
                            Foreground="White" BorderThickness="0"
                            FontWeight="SemiBold" Cursor="Hand"
                            Click="Ajouter_Click"/>
                </Grid>

                <!-- recherche et filtre par programme -->
                <Grid Grid.Row="1" Margin="0,7,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="185"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="RechercheTextBox" Grid.Column="0" Height="36"
                             Padding="10,7" VerticalContentAlignment="Center"
                             ToolTip="Rechercher un étudiant..."
                             TextChanged="Recherche_TextChanged"/>
                    <ComboBox x:Name="FiltreProgrammeComboBox" Grid.Column="2"
                              Height="36" Padding="8" VerticalContentAlignment="Center"
                              SelectionChanged="FiltreProgramme_SelectionChanged">
                        <ComboBoxItem Content="Tous les programmes" IsSelected="True"/>
                        <ComboBoxItem Content="Informatique"/>
                        <ComboBoxItem Content="Génie logiciel"/>
                        <ComboBoxItem Content="Cybersécurité"/>
                    </ComboBox>
                    <TextBlock x:Name="NombreEtudiantsTextBlock" Grid.Column="4"
                               Text="5 étudiants" FontSize="11" Foreground="#718096"
                               VerticalAlignment="Center" TextAlignment="Right"/>
                </Grid>

                <!-- tableau des étudiants -->
                <Border Grid.Row="2" Background="White" BorderBrush="#D9E1EA"
                        BorderThickness="1" CornerRadius="5" Padding="6">
                    <ListView x:Name="ListeEtudiants" BorderThickness="0"
                              Background="White">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="NOM" Width="105"
                                                DisplayMemberBinding="{Binding Nom}"/>
                                <GridViewColumn Header="PRÉNOM" Width="105"
                                                DisplayMemberBinding="{Binding Prenom}"/>
                                <GridViewColumn Header="PROGRAMME" Width="145">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#E2ECF9" CornerRadius="9"
                                                    Padding="7,3" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Programme}"
                                                           Foreground="#315C91" FontSize="11"/>
                                            </Border>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="COURRIEL" Width="230"
                                                DisplayMemberBinding="{Binding Courriel}"/>
                                <GridViewColumn Header="ACTIONS" Width="170">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Modifier" Padding="3,2"
                                                        Foreground="#315C91" Background="Transparent"
                                                        BorderThickness="0" Cursor="Hand"
                                                        Click="Modifier_Click"/>
                                                <TextBlock Text=" · " Foreground="#9AA7B5"
                                                           VerticalAlignment="Center"/>
                                                <Button Content="Supprimer" Padding="3,2"
                                                        Foreground="#B54747" Background="Transparent"
                                                        BorderThickness="0" Cursor="Hand"
                                                        Click="Supprimer_Click"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>
            </Grid>
        </Grid>

        <!-- information au bas de la fenêtre -->
        <Border Grid.Row="2" Background="White" BorderBrush="#D9E1EA"
                BorderThickness="0,1,0,0">
            <TextBlock Text="●  Connecté : Amine Alioui     |     Liste des étudiants"
                       Foreground="#63758A" FontSize="10"
                       VerticalAlignment="Center" Margin="12,0"/>
        </Border>
    </Grid>
</Window>
